{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Textflow",
  "version": "0.1.0",
  "identifier": "app.textflow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Textflow",
        "width": 1000,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "./icons/Assets.car"
      }
    }
  }
}
