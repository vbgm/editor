{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Textflow",
  "version": "0.1.0",
  "identifier": "app.textflow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Textflow",
        "width": 1000,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "contentTypes": ["net.daringfireball.markdown"],
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["rtf"],
        "name": "Rich Text",
        "description": "Rich Text document",
        "mimeType": "application/rtf",
        "contentTypes": ["public.rtf"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["docx"],
        "name": "Word",
        "description": "Word document",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "contentTypes": ["org.openxmlformats.wordprocessingml.document"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["odt"],
        "name": "OpenDocument Text",
        "description": "OpenDocument text",
        "mimeType": "application/vnd.oasis.opendocument.text",
        "contentTypes": ["org.oasis-open.opendocument.text"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["pdf"],
        "name": "PDF",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "contentTypes": ["com.adobe.pdf"],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "./icons/Assets.car"
      }
    }
  }
}
